{
  "manifest_version": 2,
  "name": "xnLinkFinder",
  "version": "1.0.0",
  "description": "Capture endpoints from browser traffic",
  "permissions": ["webRequest", "storage", "tabs", "<all_urls>"],
  "browser_action": {
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }]
}
